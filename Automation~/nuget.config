<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Where packages may come from.

    Without a repository-level file, restore inherits whatever feeds the
    machine happens to have configured, which makes the resolved graph a
    property of the developer rather than of the commit. `clear` drops the
    inherited set so the sources below are the whole of it.

    packageSourceMapping is the half that matters once a second feed is ever
    added: a package is looked up only in the sources whose patterns match it,
    so a private or internal name cannot be silently satisfied by a public feed
    that happens to answer first. With one source the mapping is trivially
    true; its purpose is that adding a feed becomes an explicit act with an
    explicit scope rather than a widening nobody has to state.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!--
    Package signature verification is deliberately not declared here. NuGet's
    `signatureValidationMode` is honoured by the .NET SDK on Windows and is
    inert on Linux unless DOTNET_NUGET_SIGNATURE_VERIFICATION is set, and every
    package on the one source above is repository-signed — so the setting could
    not be shown to refuse anything on the hosts that build this repository. A
    control that cannot be demonstrated reads as coverage that is not there.
  -->

</configuration>

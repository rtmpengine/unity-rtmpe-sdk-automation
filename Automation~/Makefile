# The conversion verbs, lifted verbatim from the RTMPE repository's Makefile so
# that every command the documentation gives you runs here unchanged.

ANALYZER_DIR := clients/unity-sdk/Tooling

.PHONY: readiness convert convert-batch fix gen-rpc advise

readiness: ## Emit the Network Readiness artifact for the SDK samples into the Unity project root (the Readiness editor window reads it): make readiness [OUT=dir] [SOURCE=dir] [ASSETS=dir] [DEFINE="SYM1 SYM2"] [ANSWERS=path] [RUNTIME=path]
	@dotnet run --project $(ANALYZER_DIR)/RTMPE.SDK.ConversionCli -c Release -- \
		readiness $(if $(SOURCE),--source "$(SOURCE)",--repo-root "$(CURDIR)") \
		$(foreach symbol,$(DEFINE),--define "$(symbol)") \
		$(if $(ANSWERS),--answers "$(ANSWERS)",) \
		$(if $(RUNTIME),--runtime "$(RUNTIME)",) \
		$(if $(ASSETS),--assets "$(ASSETS)",) \
		--out "$(if $(OUT),$(OUT),clients/unity-sdk)"

convert: ## Headless NetworkVariable conversion host: make convert FILE=path.cs TYPE=Fq.Name MEMBER="_field[:companion] ..." [APPLY=1]
	@dotnet run --project $(ANALYZER_DIR)/RTMPE.SDK.ConversionCli -c Release -- \
		--file "$(FILE)" --type "$(TYPE)" \
		$(foreach member,$(MEMBER),--member "$(member)") $(if $(APPLY),--apply,)

convert-batch: ## Headless multi-type conversion host: make convert-batch ARGS="--file a.cs --type A --member _x --file b.cs --type B --member _y" [APPLY=1]
	@dotnet run --project $(ANALYZER_DIR)/RTMPE.SDK.ConversionCli -c Release -- \
		convert-batch $(if $(APPLY),--apply,) $(ARGS)

fix: ## Headless identity-free conversion host: make fix FILE=path.cs TYPE=Fq.Name KIND=rebase|owner-guard|base-ondestroy [METHOD=FrameLoop] [APPLY=1]
	@dotnet run --project $(ANALYZER_DIR)/RTMPE.SDK.ConversionCli -c Release -- \
		fix --file "$(FILE)" --type "$(TYPE)" --kind "$(KIND)" \
		$(if $(METHOD),--method "$(METHOD)",) $(if $(APPLY),--apply,)

gen-rpc: ## Headless Enhanced-RPC generation host: make gen-rpc FILE=path.cs TYPE=Fq.Name METHOD="Name[:Target] ..." [APPLY=1]
	@dotnet run --project $(ANALYZER_DIR)/RTMPE.SDK.ConversionCli -c Release -- \
		gen-rpc --file "$(FILE)" --type "$(TYPE)" \
		$(foreach method,$(METHOD),--method "$(method)") $(if $(APPLY),--apply,)

advise: ## AI judgment layer — not part of the distributed toolchain
	@echo "The AI judgment layer is not distributed with the SDK."
	@echo "It runs in the RTMPE backend and needs credentials of its own."
	@exit 1


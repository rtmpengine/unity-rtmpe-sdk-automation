<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>RTMPE.SDK.CodeFixes</AssemblyName>
    <RootNamespace>RTMPE.SDK.CodeFixes</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- CodeFixProvider/CodeAction live in the Workspaces layer, which the IDE host
         (Rider/VS) provides — referenced PrivateAssets=all so it is not packaged or
         flowed transitively, mirroring how the analyzer references the compiler.
         Pinned to the same 4.3.0 line as the analyzer (one host-version verdict
         covers both). The Unity-side wizard does NOT load this assembly; conversion
         in Unity runs through the same RTMPE.SDK.Transforms core via the wizard. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RTMPE.SDK.Analyzers\RTMPE.SDK.Analyzers.csproj" />
    <ProjectReference Include="..\RTMPE.SDK.Transforms\RTMPE.SDK.Transforms.csproj" />
    <!-- The ledger reader/type map: the fix materializes ledger-issued ids only. -->
    <ProjectReference Include="..\RTMPE.SDK.Conversion.Core\RTMPE.SDK.Conversion.Core.csproj" />
  </ItemGroup>

  <!-- This DLL ships inside the Unity package and is byte-compared against a
       fresh build by check-analyzers-fresh, so its Release bytes must be a
       pure function of source + compiler (the SDK is pinned by the
       Tooling-scoped global.json — scoped there, not repo-root, so the pin
       governs exactly the byte-compared builds and nothing else). Two SDK
       defaults break that and are disabled here:
       • a Release PDB embeds the build machine's absolute obj/ path in the
         PE debug directory — a CI checkout can never reproduce a dev-box
         path, so no PDB is emitted (Debug builds keep full symbols);
       • the git integration stamps HEAD's commit SHA into
         AssemblyInformationalVersion — the committed DLL would always carry
         the previous commit's SHA while a CI rebuild stamps the new one,
         making the freshness gate unpassable by construction. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <PropertyGroup>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
